# ============================================================
# Real Local — 환경변수 (PRD v1.3 §7.5)
#
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋되지 않는다.
#
# ⚠️ 구글 키는 반드시 2개다. 하나로 합치면 서버 전용 권한이 브라우저로 나간다.
# ============================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 시드 스크립트 전용. RLS 를 통째로 우회하므로 앱 코드에서 import 하지 말 것.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 나간다.
SUPABASE_SERVICE_ROLE_KEY=


# ---------- Google — 브라우저용 ----------
# Maps JavaScript API 만. Cloud Console 에서 두 가지 제한을 반드시 걸 것:
#   1) 애플리케이션 제한 → HTTP 리퍼러 → 배포 도메인 + localhost
#   2) API 제한 → Maps JavaScript API 하나만
# 이 키는 브라우저로 나가는 것이 정상이며, 보안은 숨김이 아니라 제한으로 건다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 선택. Cloud Console > 지도 스타일에서 만드는 Map ID.
# 넣으면 번호 핀이 AdvancedMarkerElement 로 뜨고, 비워 두면 기본 마커에 라벨만 얹힌다.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=


# ---------- Google — 서버용 ----------
# Places API (New): Text Search / Place Details / Place Photo.
# 절대 NEXT_PUBLIC_ 을 붙이지 말 것. 붙는 순간 클라이언트 번들에 실린다.
# 검증: npm run build 후 .next 에서 이 값을 grep 해 0건이어야 한다 (§12 AC-NFR).
GOOGLE_PLACES_SERVER_KEY=


# ---------- 구글 로그인 ----------
# OAuth 클라이언트 ID/시크릿은 여기가 아니라 Supabase 대시보드에 입력한다.
# Authentication > Providers > Google.
# 자격증명 종류 자체가 API 키와 다르다(클라이언트 ID/시크릿). 혼동하지 말 것.
